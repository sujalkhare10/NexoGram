rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users / Profiles collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Profiles are preserved
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      // Allow author to update content or allow authenticated users to increment like_count/comment_count
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Likes collection (document ID: {postId}_{userId})
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Bookmarks collection (document ID: {postId}_{userId})
    // Only the owner can view or manage their bookmarks
    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Follows collection (document ID: {followerId}_{followingId})
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.follower_id == request.auth.uid &&
                    request.resource.data.follower_id != request.resource.data.following_id;
      allow delete: if isAuthenticated() && resource.data.follower_id == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Recipient can read their own notifications
      allow read: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
      // Authenticated users can create notifications when interacting
      allow create: if isAuthenticated();
      // Only recipient can mark as read
      allow update: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
    }
  }
}

